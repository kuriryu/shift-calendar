# 事前発行するアクセスパスワード（必須）
ACCESS_PASSWORD=20010926

# セッション署名用（本番ではランダムな長い文字列に変更）
SESSION_SECRET=replace-with-long-random-string

# 共有データの保存先。未設定ならローカルの data/shared-state.json を使う
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# LINE公式アカウント（Messaging API）。未設定のあいだは募集の自動配信を行わない
# チャネルシークレットと長期のチャネルアクセストークンは LINE Developers のチャネルから発行する
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# ベーシックID。先頭の @ はあってもなくてもよい。友達追加リンクに使う
LINE_BASIC_ID=
# メッセージ内の希望URLに使う公開オリジン。未設定ならリクエストのホストを使う
APP_ORIGIN=

# 任意: 既存の Supabase（現在のログインには未使用）
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
